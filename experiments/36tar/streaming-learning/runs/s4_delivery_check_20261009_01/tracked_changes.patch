         """We have a previous state if the last linear (conv) layer was already updated."""
         return self.conv_states[self.last_linear_layer] is not None
 
+    def clone(self):
+        """Fork all tensor storage; weights and model position state live elsewhere."""
+        cloned = object.__new__(type(self))
+        cloned.layer_types = list(self.layer_types)
+        cloned.transformer_layers = list(self.transformer_layers)
+        cloned.last_linear_layer = self.last_linear_layer
+        for field in ("key_cache", "value_cache", "conv_states", "recurrent_states"):
+            setattr(cloned, field, [None if tensor is None else tensor.clone() for tensor in getattr(self, field)])
+        return cloned
+
+    def reset(self):
+        """Drop this cache's history while preserving its layer layout."""
+        for field in ("key_cache", "value_cache", "conv_states", "recurrent_states"):
+            setattr(self, field, [None for _ in self.layer_types])
+
 
